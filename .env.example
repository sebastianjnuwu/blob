# Server 
BLOB_PORT="3000"
BLOB_HOST="localhost"

# Database URL (e.g., postgres://user:password@host:port/dbname)
BLOB_DATABASE_URL="postgres://blob:blob@localhost:5432/blob"

# Redis URL (e.g., redis://localhost:6379)
REDIS_URL="redis://localhost:6379/0"

# Path where uploaded files will be stored (relative to the project root)
# Default is "storage/uploads".
# Example: (e.g storage/uploads)
BLOB_STORAGE_PATH="storage/uploads"

# Master bearer token (full access). Leave EMPTY to disable it and rely only
# on BLOB_API_KEYS. If set, use a unique secret with at least 32 characters;
# the server refuses to start with the known placeholder or a short value.
BLOB_TOKEN_SECRET=

# Comma-separated API keys with optional permission scopes.
# Entries are separated by ';' and scopes by ','.
# Each entry is "token" (full access) or "token:read,write,delete".
# Example: (e.g k1:read;k2:read,write;k3:read,write,delete)
BLOB_API_KEYS="my-full-access-key:read,write,delete;my-read-only-key:read"

# Secret for HMAC-signing download/view URLs. REQUIRED (min 16 chars): the
# server fails to start without it. It is never derived from BLOB_TOKEN_SECRET.
# Example: (e.g a-different-32-char-secret)
BLOB_SIGNED_URL_SECRET="a-different-32-char-secret-value-here"

# Lifetime of generated signed URLs (Go duration: 5m, 1h, 24h...)
# Default: 15m
BLOB_SIGNED_URL_TTL="15m"

# Enable legacy access to private blobs via ?hash=<sha256>. The hash equals the
# content hash and is exposed in blob metadata, so disable this in production
# and rely on signed URLs or tokens.
# Accepts true/false. Default: true
BLOB_HASH_FALLBACK_ENABLED="true"

# Set this when the API runs behind a reverse proxy so the rate limiter and
# signed-URL host detection honor X-Forwarded-For/X-Real-IP/X-Forwarded-Host.
# Accepts true/false. Default: false
BLOB_TRUST_PROXY="false"

# Optional: fixed public base URL used to build signed download/view URLs
# (e.g. https://blob.example.com). Takes precedence over the request Host.
# Leave empty to derive from the request (or forwarded headers when trusted).
BLOB_PUBLIC_URL=

# Enable content deduplication: blobs with an identical SHA256 share the same
# physical file and are only removed when the last reference is deleted.
# Accepts true/false. Default: false
BLOB_DEDUP_ENABLED="false"

# Download rate limiting (requests per window)
# Default is 120 requests per window.
# Example: (e.g 120 for 120 requests per window)
BLOB_RATE_LIMIT_MAX="120"

# Time window for download rate limiting in milliseconds (e.g., 60000 for 1 minute)
# Default is 60000 ms (1 minute).
# Example: (e.g 60000 for 1 minute)
BLOB_RATE_LIMIT_WINDOW_MS="60000"

# Allowed MIME types for upload (comma-separated)
# Default is "image/png,image/jpeg,image/gif,image/webp". 
# Example: (e.g image/png,image/jpeg,image/gif,image/webp)
BLOB_ALLOWED_MIME_TYPES="image/png,image/jpeg,image/gif,image/webp"

# Chunk size limits for multipart upload (in bytes)
# Minimum chunk size (default: 1MB = 1048576)
# Example: (e.g 1048576 for 1MB)
BLOB_MIN_CHUNK_SIZE="1048576"

# Chunk size limits for multipart upload (in bytes)
# Maximum chunk size (default: 20MB = 20971520)
# Example: (e.g 20971520 for 20MB)
BLOB_MAX_CHUNK_SIZE="20971520"

# Optional: set a maximum upload size (in bytes) to prevent abuse (e.g., 10MB = 10485760 bytes)
# Default is 100MB.
# Example: (e.g 104.857.600 for 100MB)
BLOB_MAX_UPLOAD_SIZE_BYTES="104857600"

# Optional: set a maximum total storage size (in bytes) to prevent disk overflow (e.g., 1GB = 1073741824 bytes)
# Default is 1GB.
# Example: (e.g 1073741824 for 1GB)
BLOB_MAX_STORAGE_SIZE="1073741824"

# Optional: enable CORS and specify allowed origins (comma-separated)
# Default is "*" to allow all origins.
# Example: (e.g http://localhost:3000,http://example.com)
BLOB_CORS_ORIGINS="http://localhost:3000"

# Interval to run the cleanup task that deletes expired blobs
# Accepts Go duration format (e.g. 30s, 10m, 24h, 7d)
# Default: 24h
# Example: (e.g 30s for every 30 seconds, 24h for every 24 hours)
BLOB_EXPIRED_CLEANUP_INTERVAL="24h"

# Interval to run the cleanup task that deletes unfinished multipart upload temp chunks
# This controls how often the cleanup job runs (e.g. every 1h, 24h, 30s)
# Example: 1h (every hour), 24h (every day), 30s (every 30 seconds)
BLOB_TMP_CLEANUP_INTERVAL="24h"

# Threshold: only remove unfinished uploads older than this duration
# This controls the minimum age of an unfinished upload to be considered for deletion
# Example: 24h (remove uploads not finished after 24h), 1h (after 1 hour), 30s (after 30 seconds)
BLOB_TMP_CLEANUP_THRESHOLD="24h"